# PostgreSQL + pgvector Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=home_cc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/home_cc

# Embedding Configuration
# Provider: fastembed (default, local ONNX), ollama (local REST), or openai (cloud API)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# Ollama Configuration (if EMBEDDING_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text

# OpenAI Configuration (if EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=text-embedding-3-small
OPENAI_BASE_URL=
